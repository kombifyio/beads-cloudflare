{
  "name": "beads-cloudflare",
  "version": "0.1.12",
  "private": true,
  "description": "Cloudflare-hosted store for Beads: a declared profile of the bd serve /v0 HTTP contract plus an MCP server.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "beads-cloudflare": "cli/beads-cloudflare.mjs"
  },
  "files": [
    "cli/",
    "src/",
    "cloudflare.config.ts",
    "wrangler.jsonc",
    "VERSION",
    "SETUP.md",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/compatibility.md",
    "docs/cloudflare-cli.md",
    "docs/artifacts.md",
    "docs/operations.md",
    "docs/profile.md",
    "scripts/tracker-snapshot.mjs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "types": "wrangler types --strict-vars=false",
    "gen": "openapi-typescript spec/upstream/openapi.v0.yaml -o src/generated/openapi.v0.ts",
    "typecheck": "pnpm types && tsc --noEmit",
    "test": "vitest run",
    "test:cli": "node --test \"cli/*.test.mjs\"",
    "test:pure": "node --test test/http-body.pure.test.mjs test/tracker-snapshot.pure.test.mjs scripts/import-prefix.test.mjs scripts/conformance-result.test.mjs scripts/release-artifacts.test.mjs",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "2.3.1",
    "cf": "1.0.0-beta.14",
    "wrangler": "4.149.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@types/node": "^26.6.4",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.23.3"
  }
}
